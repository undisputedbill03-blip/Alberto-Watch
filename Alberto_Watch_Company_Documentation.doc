<!-- PROJECT ARCHITECTURE -->
<h2>4. Directory & File Structure</h2>
<pre><code>alberto-watch-company/
├── public/                       # Static public assets
│   ├── classic_watch.png
│   ├── favicon.svg
│   ├── hero_banner.png
│   ├── luxury_watch.png
│   ├── smart_watch.png
│   ├── vintage_watch.png
│   └── watch_logo.png
├── src/
│   ├── components/               # Modular UI Components
│   │   ├── About.jsx             # Company history, Swiss horology credentials, AWCI highlights
│   │   ├── Contact.jsx           # Communication cards, social badges, interactive inquiry form
│   │   ├── Footer.jsx            # Multi-tier sitemap, contact links, brand overview, copyright
│   │   ├── Gallery.jsx           # Media showcase with zoom hover effect and fullscreen lightbox
│   │   ├── Hero.jsx              # Banner headline, primary conversion CTAs, company metrics
│   │   ├── Navbar.jsx            # Responsive sticky navbar, mobile drawer, visitor count pill
│   │   ├── PriceList.jsx         # Full tabular price list with technical specifications & stock status
│   │   ├── Products.jsx          # Tabbed category filters, product cards, detailed spec modal
│   │   ├── SocialIcons.jsx       # Scalable SVG vector components for social media channels
│   │   ├── StoreLocator.jsx      # Multi-boutique switcher with address, hours, and direct Google Maps
│   │   ├── Support.jsx           # Guarantee badges (Repair, Warranty, Shipping) & FAQ accordion
│   │   ├── Technology.jsx        # Horological movements (COSC, Eco-Drive, Sapphire, 262 kHz quartz)
│   │   └── Ticker.jsx            # Real-time ticking time, geolocation lookup, infinite ticker bar
│   ├── data/
│   │   └── watchData.js          # Centralized data store (watches, FAQs, boutiques, innovations)
│   ├── App.jsx                   # Master layout with IntersectionObserver viewport tracking
│   ├── index.css                 # Gold luxury design tokens, responsive breakpoints, keyframes
│   └── main.jsx                  # React application entry point
├── package.json                  # Manifest & dependencies
└── vite.config.js                # Vite build configuration</code></pre>

